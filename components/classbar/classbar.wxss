.cb {
  background: var(--card);
  padding: 8px 12px 6px;
  box-shadow: 0 1px 3px var(--shadow);
}
.cb-scroll { white-space: nowrap; }
.cb-chip {
  display: inline-block;
  padding: 5px 14px;
  margin-right: 8px;
  border-radius: 999px;
  background: var(--card-2);
  color: var(--text);
  font-size: 13px;
  line-height: 1.5;
}
.cb-chip.on { background: var(--brand); color: var(--on-brand); font-weight: 600; }
.cb-chip.lk { background: var(--lock-w); color: var(--lock); }
.cb-chip.on.lk { background: var(--lock); color: #FFF; }
.cb-row2 {
  display: flex;
  align-items: center;
  margin-top: 8px;
}
.cb-mgr {
  flex-shrink: 0;
  font-size: 12px;
  color: var(--brand);
  border: 1px solid var(--line-2);
  border-radius: 999px;
  padding: 3px 12px;
  margin-right: 8px;
  background: var(--brand-w);
}
.cb-mgr-del { color: var(--danger); border-color: var(--danger-w); background: var(--danger-w); }
.cb-gear {
  flex-shrink: 0;
  margin-left: 6px;
  font-size: 12px;
  color: var(--brand);
  border: 1px solid var(--line-2);
  border-radius: 999px;
  padding: 3px 12px;
}
.cb-hover { opacity: 0.6; }
.spacer { flex: 1; }