<view class="page-root {{themeClass}}">
<classbar classes="{{dirClasses}}" curIdx="{{s.currentClass || 0}}" bindswitch="onSwitch" />

<!-- 连接失败/连接中 兜底卡（不再白屏）：s 为 null 时必有可见反馈 -->
<view class="card" wx:if="{{!s}}">
  <view wx:if="{{errTxt}}" class="err" style="font-weight:600">⚠ 连接云端失败</view>
  <view wx:elif="{{!errTxt}}" class="muted">正在连接云端…</view>
  <view wx:if="{{errTxt}}" class="muted mt6" style="font-size:12px">{{errTxt}}</view>
  <view class="row-gap mt10" wx:if="{{errTxt}}">
    <view class="btn btn-sm" bindtap="onRetry">重试</view>
    <view class="spacer"></view>
    <view class="btn btn-sm btn-light" bindtap="goConnect">⚙ 连接设置</view>
  </view>
  <!-- 首次使用无需云端密码：PIN 由 proxy 云函数注入 -->
</view>

<lockoverlay show="{{s && s.locked}}" name="{{(s && s.className) || ''}}" bind:unlocked="onSwitch" />

<block wx:if="{{s && !s.locked}}">
  <!-- 分组管理 -->
  <view class="card">
    <view class="label">分组管理（点分组可筛选下方学生；×删除组不影响学生）</view>
    <view class="row-gap">
      <input class="field" style="flex:1" placeholder="新组名（如：第1组 / 男生）" value="{{newGroup}}" bindinput="onNewGroup" />
      <view class="btn btn-sm" bindtap="onAddGroup">添加组</view>
    </view>
    <view class="mt6">
      <view class="chip {{selGroup === '' ? 'on' : ''}}" data-g="" bindtap="onGroup">全部</view>
      <view wx:for="{{s.groups}}" wx:key="*this" class="chip {{selGroup === item ? 'on' : ''}}" data-g="{{item}}" bindtap="onGroup">{{item}}
        <text catchtap="onDelGroup" data-g="{{item}}" style="color:var(--danger);font-weight:700"> ×</text>
      </view>
    </view>
  </view>

  <!-- 粘贴导入新班级 -->
  <view class="card">
    <view class="label">粘贴导入新班级（一行一名：姓名,学号,组别,权重 / 姓名,组别）</view>
    <textarea class="textarea" placeholder="张三,2024001,第1组,1&#10;李四,2024002,第2组,2&#10;王五&#10;……" value="{{importText}}" bindinput="onImportText"></textarea>
    <view class="row-gap mt8">
      <input class="field" style="flex:1" placeholder="班级名称（如：初一(3)班，留空=自动命名）" value="{{importName}}" bindinput="onImportName" />
      <view class="btn btn-sm" bindtap="onImport">导入</view>
    </view>
  </view>

  <!-- 添加单个学生 -->
  <view class="card">
    <view class="label">添加单个学生</view>
    <view class="row-gap">
      <input class="field" style="flex:2" placeholder="姓名" value="{{addName}}" bindinput="onAddName" />
      <input class="field" style="flex:1.2" placeholder="学号" value="{{addSid}}" bindinput="onAddSid" />
    </view>
    <view class="row-gap mt8">
      <input class="field" style="flex:1.6" placeholder="组别（选填）" value="{{addGroup}}" bindinput="onAddGroupIn" />
      <input class="field" style="flex:.8" placeholder="权重" value="{{addWeight}}" bindinput="onAddWeight" />
      <view class="btn btn-sm" bindtap="onAddStudent">添加</view>
    </view>
    <view class="tip mt6">权重=被抽中的相对概率（1 为普通）；0 表示该生不参与点名。</view>
  </view>

  <!-- 学生列表 -->
  <view class="card">
    <view class="row-gap">
      <text class="label" style="margin:0">学生（{{shown.length}}）</text>
      <view class="spacer"></view>
      <view class="btn btn-sm btn-danger" bindtap="onResetStats">清零统计</view>
    </view>
    <view wx:if="{{!shown.length}}" class="empty">暂无学生，用上方导入或逐个添加</view>
    <view wx:for="{{shown}}" wx:key="name" class="stu-row">
      <view style="flex:1.1;min-width:84px">
        <view style="font-size:15px;font-weight:600">{{item.name}}<text wx:if="{{item.abs}}" class="danger-txt" style="font-size:11px;margin-left:4px">📌请假</text></view>
        <view class="tip" wx:if="{{item.group || item.pickedCount}}">{{item.group ? ('[' + item.group + '] ') : ''}}被点{{item.pickedCount || 0}}</view>
      </view>
      <input class="sid-in" placeholder="学号" value="{{item.sid}}" data-name="{{item.name}}" bindblur="onSidBlur" />
      <input class="w-in" type="digit" value="{{item.weight}}" data-name="{{item.name}}" bindblur="onWeightBlur" />
      <view class="pin {{item.abs ? 'on' : ''}}" data-name="{{item.name}}" bindtap="onAbsentTap">📌</view>
      <view class="del" data-name="{{item.name}}" bindtap="onDelStudent">✕</view>
    </view>
  </view>
</block>
</view>
