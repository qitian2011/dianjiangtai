.stu-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 2px;
  border-bottom: 1px solid var(--line);
}
.stu-row:last-child { border-bottom: none; }
.sid-in {
  flex: 1.2;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  padding: 5px 8px;
  font-size: 13px;
  background: var(--card);
  color: var(--text);
  min-width: 0;
}
.w-in {
  width: 52px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  padding: 5px 8px;
  font-size: 13px;
  background: var(--card);
  color: var(--text);
  text-align: center;
}
.del {
  color: var(--danger);
  font-size: 16px;
  padding: 4px 6px;
}
.pin {
  font-size: 15px;
  padding: 4px 6px;
  opacity: 0.45;
}
.pin.on {
  opacity: 1;
  background: var(--danger-w);
  border-radius: 8px;
}