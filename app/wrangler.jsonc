{
  // 点将台 Cloudflare 部署配置（免费套餐：Workers + 静态资产 + SQLite Durable Object）
  "name": "dianjiangtai",
  "main": "worker.js",
  "compatibility_date": "2025-05-05",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // 自定义域名：如需自动绑定，请给 API Token 加「Zone: Workers Routes: Edit」权限后取消下面注释再 deploy
  // 手动方式（推荐，无需改 Token）：Cloudflare 后台 → Workers 和 Pages → dianjiangtai → 设置 → 域和路由 → 添加自定义域 qitian.dpdns.org
  // "routes": [{ "pattern": "qitian.dpdns.org", "custom_domain": true }],
  // 访问密码：留空 "" = 不启用（任何设备打开都不弹密码）。
  // 注意：无密码时名单对学生可见、知道网址的人都能操作；如想重新启用，填个数字再 deploy 即可
  "vars": { "PIN": "" }
}
