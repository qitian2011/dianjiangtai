<view class="page-root {{themeClass}}">
<classbar classes="{{dirClasses}}" curIdx="{{s.currentClass || 0}}" bindswitch="onSwitch" />

<!-- 连接失败/连接中 兜底卡（不再白屏）：s 为 null 时必有可见反馈 -->
<view class="card" wx:if="{{!s}}">
  <view wx:if="{{errTxt}}" class="err" style="font-weight:600">⚠ 连接云端失败</view>
  <view wx:elif="{{!errTxt}}" class="muted">正在连接云端…</view>
  <view wx:if="{{errTxt}}" class="muted mt6" style="font-size:12px">{{errTxt}}</view>
  <view class="row-gap mt10" wx:if="{{errTxt}}">
    <view class="btn btn-sm" bindtap="onRetry">重试</view>
    <view class="spacer"></view>
    <view class="btn btn-sm btn-light" bindtap="goConnect">⚙ 连接设置</view>
  </view>
  <!-- 首次使用无需云端密码：PIN 由 proxy 云函数注入 -->
</view>

<lockoverlay show="{{s && s.locked}}" name="{{(s && s.className) || ''}}" bind:unlocked="onSwitch" />

<!-- 抽取范围 -->
<view class="card" wx:if="{{s && !s.locked}}">
  <view class="row-gap">
    <text class="label" style="margin:0">考试模式</text>
    <switch checked="{{s.examMode}}" color="#185FA5" style="transform:scale(.8)" bindchange="onExam" />
    <text class="tip">考试中传呼不弹大窗</text>
  </view>
  <view style="height:6px"></view>
  <view class="row-gap">
    <text class="label" style="margin:0">范围</text>
    <view class="chip {{groupSel === '' ? 'on' : ''}}" data-g="" bindtap="onGroup">全部</view>
    <block wx:for="{{s.groups}}" wx:key="*this">
      <view class="chip {{groupSel === item ? 'on' : ''}}" data-g="{{item}}" bindtap="onGroup">{{item}}</view>
    </block>
  </view>
  <view style="height:6px"></view>
  <view class="row-gap">
    <text class="label" style="margin:0">人数</text>
    <view wx:for="{{counts}}" wx:key="*this" class="chip {{countSel === item ? 'on' : ''}}" data-n="{{item}}" bindtap="onCount">{{item}}人</view>
    <view class="spacer"></view>
  </view>
  <view class="row-gap mt8">
    <text class="muted" style="font-size:13px">本轮不重复（不复读机）</text>
    <switch checked="{{noRepeat}}" color="#185FA5" style="transform:scale(.8)" bindchange="onNoRepeat" />
    <view class="spacer"></view>
    <view class="btn btn-sm btn-light" bindtap="onResetRound">重置本轮</view>
  </view>
  <view class="muted mt6" style="font-size:12px">本轮已点 {{s.pickedThisRound.length}} 人次</view>
</view>

<!-- 点名与结果 -->
<view class="card" wx:if="{{s && !s.locked}}">
  <block wx:if="{{s.answering}}">
    <view class="title-mid">{{s.answering.name}}</view>
    <view class="warn-big">{{leftTxt || '计时中…'}}</view>
    <view class="row-gap mt14" style="justify-content:center">
      <view class="btn btn-success" style="flex:1" data-m="right" bindtap="onMark">✓ 答对</view>
      <view class="btn btn-danger" style="flex:1" data-m="wrong" bindtap="onMark">✗ 答错</view>
      <view class="btn btn-light" style="flex:1" data-m="none" bindtap="onMark">未答</view>
    </view>
  </block>

  <block wx:elif="{{s.lastPick}}">
    <view wx:for="{{s.lastPick.display}}" wx:key="*this" class="title-big">{{item}}</view>
    <view class="row-gap mt14" style="justify-content:center">
      <view class="btn btn-success" style="flex:1" bindtap="onAsk">🎤 请回答</view>
      <view class="btn btn-warn" style="flex:1" bindtap="onSkip">跳过 TA →</view>
    </view>
    <view class="tip" style="text-align:center;margin-top:8px">「请回答」可选倒计时（大屏计时）；「跳过」自动补抽下一位</view>
  </block>

  <block wx:else>
    <view class="tip-center">{{rolling ? '点名动画进行中…' : '点击下方按钮开始随机点名'}}</view>
  </block>

  <view style="height:12px"></view>
  <button class="btn btn-big" disabled="{{rolling || !!s.answering}}" bindtap="onRoll">
    {{rolling ? '点 名 中 …' : '🎲 随 机 点 名'}}
  </button>
</view>

<!-- 今日请假 -->
<view class="card" wx:if="{{s && !s.locked}}">
  <view class="row-gap">
    <text class="label" style="margin:0">今日请假（点名自动跳过）</text>
    <view wx:if="{{absentCount}}" class="abs-badge">{{absentCount}} 人请假</view>
    <view class="spacer"></view>
    <view class="btn btn-sm btn-light" bindtap="onAbsentEdit">✍ 编辑</view>
    <view class="btn btn-sm btn-danger" bindtap="onAbsentClear">清空</view>
  </view>
  <view class="muted mt6" wx:if="{{absentTxt}}">已请假：{{absentTxt}}</view>
  <view class="muted mt6" wx:else>今日无人请假</view>

    <view wx:if="{{editingAbsent}}">
      <view style="height:8px"></view>
      <view class="field" style="max-height:260px;overflow-y:auto">
        <checkbox-group bindchange="onAbsentChk">
          <label wx:for="{{editingStudents}}" wx:key="name" class="abs-row">
            <checkbox value="{{item.name}}" checked="{{item.abs}}" color="#185FA5" style="transform:scale(.85)" />
            <text style="margin-left:6px">{{item.name}}</text>
          </label>
        </checkbox-group>
      </view>
    <view class="row-gap mt8">
      <view class="btn btn-sm btn-light" bindtap="onAbsentCancel">取消</view>
      <view class="spacer"></view>
      <view class="btn btn-sm" bindtap="onAbsentSave">保存请假名单</view>
    </view>
  </view>
</view>

<!-- 本节课记录 -->
<view class="card" wx:if="{{s && !s.locked}}">
  <view class="label">本节课记录</view>
  <view wx:if="{{!lessonLogV.length}}" class="empty">暂无</view>
  <view wx:for="{{lessonLogV}}" wx:key="at" class="log-item">
    <text>{{item.namesTxt}}</text>
    <text class="tag {{item.resultTag}}" wx:if="{{item.result}}">{{item.resultTxt}}</text>
    <text class="spacer"></text>
    <text class="log-time">{{item.timeTxt}}</text>
  </view>
</view>
</view>
