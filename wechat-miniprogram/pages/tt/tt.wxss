.t-in {
  width: 92px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  padding: 5px 8px;
  font-size: 13px;
  background: var(--card);
  color: var(--text);
}
.del { color: var(--danger); font-size: 15px; padding: 4px 6px; }

.tt-head { display: flex; border-bottom: 1px solid var(--line-2); padding: 4px 0; }
.tt-row { display: flex; border-bottom: 1px solid var(--line); align-items: center; }
.tt-row:last-child { border-bottom: none; }
.tt-col { width: 64px; flex-shrink: 0; font-size: 12px; color: var(--sub); text-align: center; }
.tt-col.head { font-weight: 600; color: var(--text); }
.tt-cell {
  flex: 1;
  min-width: 0;
  border: 1px solid var(--card-2);
  border-radius: 6px;
  margin: 3px;
  padding: 4px 2px;
  font-size: 13px;
  text-align: center;
  background: var(--card);
  color: var(--text);
}