<view class="page-root {{themeClass}}">
<classbar classes="{{dirClasses}}" curIdx="{{s.currentClass || 0}}" bindswitch="onSwitch" />

<!-- 连接失败/连接中 兜底卡（不再白屏）：s 为 null 时必有可见反馈 -->
<view class="card" wx:if="{{!s}}">
  <view wx:if="{{errTxt}}" class="err" style="font-weight:600">⚠ 连接云端失败</view>
  <view wx:elif="{{!errTxt}}" class="muted">正在连接云端…</view>
  <view wx:if="{{errTxt}}" class="muted mt6" style="font-size:12px">{{errTxt}}</view>
  <view class="row-gap mt10" wx:if="{{errTxt}}">
    <view class="btn btn-sm" bindtap="onRetry">重试</view>
    <view class="spacer"></view>
    <view class="btn btn-sm btn-light" bindtap="goConnect">⚙ 连接设置</view>
  </view>
  <!-- 首次使用无需云端密码：PIN 由 proxy 云函数注入 -->
</view>

<lockoverlay show="{{s && s.locked}}" name="{{(s && s.className) || ''}}" bind:unlocked="onSwitch" />

<block wx:if="{{s && !s.locked}}">
  <!-- 班级管理 -->
  <view class="card">
    <view class="label">班级管理 · 当前：{{s.className}}</view>
    <view class="row-gap">
      <input class="field" style="flex:1" placeholder="新班级名称" value="{{newName}}" bindinput="onNewName" />
      <view class="btn btn-sm" bindtap="onCreateClass">新建</view>
    </view>
    <view class="row-gap mt8">
      <input class="field" style="flex:1" placeholder="改名：输入新名称" value="{{renameText}}" bindinput="onRenameText" />
      <view class="btn btn-sm btn-light" bindtap="onRename">改名</view>
    </view>
    <view class="btn btn-sm btn-danger mt8" bindtap="onDeleteClass">🗑 删除当前班级</view>
    <view class="tip mt6">新建班级可选设置班级访问密码；删除加密班需要先输它的班级密码。</view>
  </view>

  <!-- 班级密码 -->
  <view class="card">
    <view class="label">班级访问密码（设置后：切换班级 / 删除该班都需要它）</view>
    <view class="muted mt6">{{s.locked ? '当前：已加密' : '当前：未加密'}}</view>
    <view class="row-gap mt8">
      <view class="btn btn-sm" bindtap="onSetPass">🔒 {{s.locked ? '修改密码' : '设置密码'}}</view>
      <view class="btn btn-sm btn-light" bindtap="onClearPass">🔓 移除密码</view>
    </view>
  </view>

  <!-- 外观主题 -->
  <view class="card">
    <view class="label">外观主题</view>
    <view class="row-gap">
      <view class="chip {{themeMode === 'light' ? 'on' : ''}}" data-m="light" bindtap="onTheme">☀️ 浅色</view>
      <view class="chip {{themeMode === 'dark' ? 'on' : ''}}" data-m="dark" bindtap="onTheme">🌙 深色</view>
      <view class="chip {{themeMode === 'system' ? 'on' : ''}}" data-m="system" bindtap="onTheme">🖥 跟随系统</view>
    </view>
    <view class="tip mt6">跟随系统时按手机「深色模式」自动切换；底部导航栏与输入框颜色会随之变化。</view>
  </view>

  <!-- 偏好 -->
  <view class="card">
    <view class="label">抽取动画时长（大屏点名动画）</view>
    <view class="row-gap">
      <view class="chip {{s.animationMs === 2000 ? 'on' : ''}}" data-ms="2000" bindtap="onAnim">快 2秒</view>
      <view class="chip {{s.animationMs === 3000 ? 'on' : ''}}" data-ms="3000" bindtap="onAnim">标准 3秒</view>
      <view class="chip {{s.animationMs === 5000 ? 'on' : ''}}" data-ms="5000" bindtap="onAnim">仪式感 5秒</view>
    </view>
  </view>

  <view class="card">
    <view class="row-gap">
      <text class="label" style="margin:0">大屏显示本周课表</text>
      <switch checked="{{s.showTt}}" color="#185FA5" style="transform:scale(.8)" bindchange="onShowTt" />
    </view>
    <view class="row-gap mt8">
      <text class="label" style="margin:0">按课表自动进入考试模式</text>
      <switch checked="{{s.autoExam}}" color="#185FA5" style="transform:scale(.8)" bindchange="onAutoExam" />
    </view>
    <view class="tip mt6">考试模式：传呼不弹大窗不发声；上课自动开启、下课自动恢复（需在课表页配好每节时间）。</view>
  </view>

  <view class="card">
    <view class="label">大屏播报方式（点名/传呼/计时提示）</view>
    <view class="row-gap">
      <view class="chip {{s.voiceMode === 'sound' ? 'on' : ''}}" data-m="sound" bindtap="onVoice">🔔 仅提示音</view>
      <view class="chip {{s.voiceMode === 'ai' ? 'on' : ''}}" data-m="ai" bindtap="onVoice">🗣️ 仅AI播报</view>
      <view class="chip {{s.voiceMode === 'both' ? 'on' : ''}}" data-m="both" bindtap="onVoice">都要</view>
    </view>
    <view style="height:10px"></view>
    <view class="row-gap">
      <text style="font-size:13px;color:var(--sub);width:70px">音量 {{volValue}}%</text>
      <slider style="flex:1" min="0" max="100" value="{{volValue}}" activeColor="#185FA5" block-size="20" bindchanging="onVoling" bindchange="onVol" />
    </view>
  </view>

  <!-- 连接信息 -->
  <view class="card">
    <view class="label">连接信息</view>
    <view class="muted">当前班级房：{{roomTxt}}</view>
    <view class="muted mt6">云端域名：由云函数 proxy 的 BASE_URL 决定（当前默认 qitian.dpdns.org）</view>
    <view class="row-gap mt10">
      <view class="btn btn-sm btn-light" bindtap="goConnect">⚙ 连接与班级管理</view>
      <view class="tip">云端密码由 proxy 云函数注入，本端无需填写</view>
    </view>
    <view class="tip mt8">桌面专属项（开机自启、外观主题、AI 语音引擎）由电脑端设置，这里不再重复。</view>
  </view>
</block>
</view>
